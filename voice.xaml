<ContentPage
    
   xmlns = "http://schemas.microsoft.com/dotnet/2022/maui"
   xmlns: x = "http://schemas.microsoft.com/winfx/2009/xaml"
   x: Class = "YourApp.:voicePage"
   Title = "VoiceTranslator" >
  
    <VerticalStackLayout
    Padding = "20" 
    Spacing = "20" >


        <Label Text = "Speech Translator"
               FontSize = "22"
               HorizontalOptions = "Center" />


        <Button Text = "Start Speaking"
                HeightRequest = "60" />


        <Frame Padding = "15" >
            <Label Text = "Detected language will appear here" />
        </ Frame >z 


    </ VerticalStackLayout >


</ ContentPage >
    