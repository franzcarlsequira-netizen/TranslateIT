   <Shell
    x:Class="TranslatorApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TranslatorApp">

        <TabBar>

            <TabPage Title="Text">
                <ShellContent ContentTemplate="{DataTemplate local:TextTranslatePage}" />
            </TabPage>

            <Tab Title="Language">
                <ShellContent ContentTemplate="{DataTemplate local:LanguagePage}" />
            </Tab>

            <Tab Title="Camera">
                <ShellContent ContentTemplate="{DataTemplate local:CameraPage}" />
            </Tab>

        </TabBar>

    </Shell>
 