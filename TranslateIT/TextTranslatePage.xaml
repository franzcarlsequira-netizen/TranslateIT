<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrasnlatorApp.Mainpage">

	<ScrollView>
		<VerticalStackLayout
            Padding="25"
            Spacing="15">
			<Label
                Text="Enter Text"
                fontsize="18" />

			<Editor x:Name="Enter Text"
			     Placeholder="type Here..."
			     HeightRequest="120"/>

			<Button Text="translate"
					clicked="OntranslateClicked"/>

			<Label Text="Translated Text"
				   Fontsize="18"/>

			<Editor x:Name="outputText"
					HeighRequest="120"
					IsReadOnly="True"/>
		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
